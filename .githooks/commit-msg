#!/bin/sh

set -eu

message_file=${1:?commit message file is required}
# エディターのコメント・前後の空行を除いて検査する。
message=$(git stripspace --strip-comments < "$message_file")
case "$message" in
  ''|*'
'*)
    printf '%s\n' 'commit-msg: コミットメッセージは必ず1行にしてください。本文・フッターは使用できません。' >&2
    exit 1
    ;;
esac

# Git が作るメッセージも、上の1行制限を満たす場合だけ許可する。
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([A-Za-z0-9._/#-]+\))?!?: [^[:space:]](.*[^[:space:]])?$'
case "$message" in
  Merge\ *|Revert\ \"*\"|fixup!\ *|squash!\ *|amend!\ *) ;;
  *)
    if ! printf '%s\n' "$message" | LC_ALL=C grep -Eq "$pattern"; then
      cat >&2 <<'EOF'
commit-msg: Conventional Commits の形式で入力してください。
形式: type(scope): 説明（scope は省略可、破壊的変更は ! を使用）
例: chore: Git の開発設定を追加する
例: fix(cli): 引数の検証を修正する
Issue 番号は必須ではありません。本文・フッターは使用できません。
EOF
      exit 1
    fi
    ;;
esac

# cleanup=verbatim でもテンプレートのコメントが履歴に残らないようにする。
printf '%s\n' "$message" > "$message_file"
