#!/bin/sh

set -eu

message_file=${1:?commit message file is required}
# エディターのコメント・前後の空行を除いて検査する。
message=$(git stripspace --strip-comments < "$message_file")
case "$message" in
  ''|*'
'*)
    printf '%s\n' 'commit-msg: コミットメッセージは必ず1行にしてください。本文・フッターは使用できません。' >&2
    exit 1
    ;;
esac

# fixup 等でも元の件名に Issue 番号を要求する。merge・revert の例外は作らない。
subject=$message
case "$subject" in
  fixup!\ *|squash!\ *|amend!\ *) subject=${subject#* } ;;
esac
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)\(#[1-9][0-9]*\)!?: [^[:space:]](.*[^[:space:]])?$'
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
commit-msg: Issue 番号付きの Conventional Commits 形式で入力してください。
形式: type(#123): 説明（破壊的変更は ! を使用）
例: chore(#123): Git の開発設定を追加する
例: fix(#123): 引数の検証を修正する
本文・フッターは使用できません。PR の Development に同じ Issue を紐づけてください。
EOF
  exit 1
fi

# cleanup=verbatim でもテンプレートのコメントが履歴に残らないようにする。
printf '%s\n' "$message" > "$message_file"
